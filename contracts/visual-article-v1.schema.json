{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nustanakritwithai/HybridMind-/blob/main/contracts/visual-article-v1.schema.json",
  "title": "Hybrid Mind Visual Article Manifest V0.1",
  "description": "A2A handoff format; models provide data only, renderer creates Gutenberg. Always Draft until explicitly approved.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "hm-va/0.1"
    },
    "article_id": {
      "type": "string",
      "pattern": "^hm-[a-z0-9-]{6,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 100
    },
    "dek": {
      "type": "string",
      "minLength": 25,
      "maxLength": 800
    },
    "category": {
      "enum": [
        "ai-news",
        "explained",
        "future-lifestyle",
        "smart-buying"
      ]
    },
    "language": {
      "const": "th"
    },
    "source_post_id": {
      "type": "integer",
      "minimum": 0
    },
    "featured_media_id": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "draft"
    },
    "editorial_type": {
      "enum": [
        "owner-essay",
        "educational",
        "news",
        "buyer-guide",
        "explainer"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]{2,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "enum": [
              "official",
              "primary",
              "news",
              "user-provided",
              "site-post"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^claim-[a-z0-9-]{2,80}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "status": {
            "enum": [
              "verified",
              "vendor-claim",
              "unverified",
              "opinion",
              "owner-experience"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9-]{2,80}$"
            },
            "maxItems": 12,
            "uniqueItems": true
          },
          "notes": {
            "type": "string",
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "modules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "summary"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "minItems": 1,
                "maxItems": 10
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "bullets"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "comparison"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "use_case": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "strength": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "limitation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    }
                  },
                  "required": [
                    "name",
                    "use_case",
                    "strength",
                    "limitation"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 6
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "process"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    }
                  },
                  "required": [
                    "label",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 10
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "steps"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "decision"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "when": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "choose": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    }
                  },
                  "required": [
                    "when",
                    "choose",
                    "why"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 8
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "checklist"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "minItems": 1,
                "maxItems": 10
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "quote"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 18000
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "text",
              "attribution"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^src-[a-z0-9-]{2,80}$"
                },
                "uniqueItems": true,
                "maxItems": 15
              },
              "type": {
                "const": "narrative"
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "minItems": 1,
                "maxItems": 40
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "paragraphs"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "research": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "fact_check": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "visual_qa": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "editorial": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        }
      },
      "required": [
        "research",
        "fact_check",
        "visual_qa",
        "editorial"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "title",
    "slug",
    "dek",
    "category",
    "language",
    "source_post_id",
    "featured_media_id",
    "status",
    "editorial_type",
    "sources",
    "claims",
    "modules",
    "gates"
  ],
  "additionalProperties": false
}
