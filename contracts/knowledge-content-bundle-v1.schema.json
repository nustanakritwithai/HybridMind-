{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybridmind.online/schemas/knowledge-content-bundle-v1.json",
  "title": "HybridMind structured article content bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "articles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "articles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "knowledge-content-v1.schema.json" }
    }
  }
}
