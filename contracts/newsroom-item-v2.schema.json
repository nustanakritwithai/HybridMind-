{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hybrid Mind offline news intake V0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "canonical_url", "event_key", "title", "summary", "source_published_at", "event_at", "fetched_at"],
  "properties": {
    "source_id": {"type":"string", "pattern":"^[a-z][a-z0-9-]{2,70}$"},
    "canonical_url": {"type":"string", "format":"uri", "pattern":"^https://", "maxLength":2048},
    "event_key": {"type":"string", "minLength":12,"maxLength":200},
    "title": {"type":"string", "minLength":10, "maxLength":400},
    "summary": {"type":"string", "minLength":10, "maxLength":4000},
    "source_published_at": {"type":"string", "format":"date"},
    "event_at": {"type":["string","null"], "format":"date"},
    "fetched_at": {"type":"string", "format":"date-time"}
  }
}
