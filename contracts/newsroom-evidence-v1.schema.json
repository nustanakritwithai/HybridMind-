{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HYBRID MIND — evidence packet for news; no model-generated sources",
  "type":"object","additionalProperties":false,
  "required":["version","article_id","source_published_at","fetched_at","review_status","risk_flags","sources","evidence"],
  "properties":{
    "version":{"const":"hm-news-evidence/0.1"},
    "article_id":{"type":"string","pattern":"^hm-[a-z0-9-]{6,80}$"},
    "source_published_at":{"type":"string","format":"date"},
    "event_at":{"type":["string","null"],"format":"date"},
    "fetched_at":{"type":"string","format":"date-time"},
    "review_status":{"enum":["PASS","HOLD"]},
    "risk_flags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "sources":{"type":"array","minItems":1,"maxItems":15,"items":{
      "type":"object","additionalProperties":false,"required":["id","title","url","published_at","kind"],
      "properties":{
        "id":{"type":"string","pattern":"^src-[a-z0-9-]{2,80}$"},
        "title":{"type":"string","minLength":5},"url":{"type":"string","format":"uri","pattern":"^https://"},
        "published_at":{"type":"string","format":"date"},"kind":{"enum":["official","primary","news","user-provided","site-post"]}
      }
    }},
    "evidence":{"type":"array","minItems":1,"maxItems":100,"items":{
      "type":"object","additionalProperties":false,
      "required":["claim_id","claim_text","source_id","evidence_text","attribution","review"],
      "properties":{
        "claim_id":{"type":"string","pattern":"^claim-[a-z0-9-]{2,80}$"},
        "claim_text":{"type":"string","minLength":10},"source_id":{"type":"string","pattern":"^src-[a-z0-9-]{2,80}$"},
        "evidence_text":{"type":"string","minLength":5,"maxLength":800},
        "attribution":{"enum":["primary-statement","independently-verified"]},
        "review":{"enum":["PASS","HOLD"]}
      }
    }}
  }
}
